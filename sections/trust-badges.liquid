{% style %}
.trust-badges-section {
  padding: 6rem 2rem;
  background: #ffffff;
}

.trust-badges-section__heading {
  text-align: center;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  margin-bottom: 4rem;
  color: #2D2D2D;
}

.trust-badges-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
  max-width: 1200px;
  margin: 0 auto;
}

.trust-badge {
  text-align: center;
  padding: 2rem;
  border-radius: 20px;
  background: #F8F8F8;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.trust-badge:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.trust-badge__icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1.5rem;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.trust-badge__icon svg {
  width: 28px;
  height: 28px;
}

.trust-badge__title {
  font-size: 1.6rem;
  font-weight: 700;
  margin-bottom: 0.8rem;
  color: #2D2D2D;
}

.trust-badge__text {
  font-size: 1.4rem;
  color: #666;
  line-height: 1.5;
}

@media screen and (max-width: 989px) {
  .trust-badges-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 749px) {
  .trust-badges-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
{% endstyle %}

<div class="trust-badges-section">
  <h2 class="trust-badges-section__heading">{{ section.settings.heading }}</h2>
  
  <div class="trust-badges-grid">
    {% for i in (1..4) %}
      {% capture icon_key %}badge_{{ i }}_icon{% endcapture %}
      {% capture title_key %}badge_{{ i }}_title{% endcapture %}
      {% capture text_key %}badge_{{ i }}_text{% endcapture %}
      
      {% if section.settings[title_key] != blank %}
        <div class="trust-badge">
          <div class="trust-badge__icon">
            {% case section.settings[icon_key] %}
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'refresh' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.13-3.36L23 10M1 14l5.64 4.36A9 9 0 0020.49 15"/></svg>
              {% when 'heart' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            {% endcase %}
          </div>
          <h3 class="trust-badge__title">{{ section.settings[title_key] }}</h3>
          <p class="trust-badge__text">{{ section.settings[text_key] }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

