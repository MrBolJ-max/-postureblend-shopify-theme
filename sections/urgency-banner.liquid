{% style %}
.urgency-banner-section {
  position: relative;
  z-index: 100;
  padding: 1.2rem 2rem;
  text-align: center;
  font-size: 1.4rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  animation: pulse 2s infinite;
}
.urgency-countdown {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}

@media screen and (max-width: 749px) {
  .urgency-banner-section {
    font-size: 1.2rem;
    padding: 1rem 1.5rem;
  }
}
{% endstyle %}

<div class="urgency-banner-section" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <span>{{ section.settings.text }}</span>
  {%- if section.settings.show_countdown and section.settings.countdown_deadline != blank -%}
    <span style="margin-left:12px;font-weight:800;" data-countdown data-deadline="{{ section.settings.countdown_deadline }}"></span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Urgency Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Banner Text",
      "default": "🔥 Free shipping on orders over $35 | 30-day money-back guarantee"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": false,
      "info": "Requires a real deadline below. Fake countdowns violate ad policies."
    },
    {
      "type": "text",
      "id": "countdown_deadline",
      "label": "Countdown Deadline",
      "info": "ISO format: 2026-05-07T23:59:59. Only used if 'Show countdown' is enabled."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FF6B9D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Urgency Banner"
    }
  ]
}
{% endschema %}
