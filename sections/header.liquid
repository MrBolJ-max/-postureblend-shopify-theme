<style>
.site-header {
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  position: sticky;
  top: 0;
  z-index: 99;
  transition: all 0.3s ease;
}
.site-header.scrolled {
  background: rgba(0,0,0,0.95);
}
.header-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #fff;
  text-decoration: none;
}
.logo span {
  color: #888;
}
.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
  margin: 0;
  padding: 0;
}
.nav-links a {
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: color 0.2s;
}
.nav-links a:hover {
  color: #fff;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}
.cart-btn {
  position: relative;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
.cart-btn svg {
  width: 24px;
  height: 24px;
  stroke: #fff;
}
.cart-count {
  position: absolute;
  top: 0;
  right: 0;
  background: #fff;
  color: #000;
  font-size: 10px;
  font-weight: 800;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
@media (max-width: 768px) {
  .nav-links { display: none; }
  .mobile-menu-btn { display: block; }
}
</style>

<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a href="/" class="logo">Posture<span>Blend</span></a>
    <nav>
      <ul class="nav-links">
        {%- for link in linklists[section.settings.menu].links -%}
          <li>
            <a href="{{ link.url }}" {% if link.active %}style="color:#fff;"{% endif %}>
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="header-actions">
      <a href="/cart" class="cart-btn" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6L5 3H2"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <button class="mobile-menu-btn" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div id="mobile-menu" class="mobile-menu" data-mobile-menu>
  <div class="mobile-menu-overlay"></div>
  <div class="mobile-menu-panel">
    <button class="mobile-menu-close" onclick="document.getElementById('mobile-menu').classList.remove('open')">✕</button>
    <nav class="mobile-nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
</div>

<style>
.mobile-menu { position: fixed; inset: 0; z-index: 999; visibility: hidden; opacity: 0; transition: all 0.3s; }
.mobile-menu.open { visibility: visible; opacity: 1; }
.mobile-menu-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
.mobile-menu-panel { position: absolute; right: 0; top: 0; bottom: 0; width: 280px; background: #fff; padding: 24px; transform: translateX(100%); transition: transform 0.3s; }
.mobile-menu.open .mobile-menu-panel { transform: translateX(0); }
.mobile-menu-close { position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 20px; cursor: pointer; color: #1E3A5F; }
.mobile-nav { display: flex; flex-direction: column; gap: 20px; margin-top: 48px; }
.mobile-nav-link { font-size: 18px; font-weight: 700; color: #1E3A5F; text-decoration: none; padding: 8px 0; border-bottom: 1px solid #eee; }
</style>

<script>
// Mobile menu toggle
document.querySelectorAll('.mobile-menu-btn').forEach(btn => {
  btn.addEventListener('click', () => document.getElementById('mobile-menu').classList.add('open'));
});
document.querySelector('.mobile-menu-overlay').addEventListener('click', () => {
  document.getElementById('mobile-menu').classList.remove('open');
});

// Sticky header scroll
document.addEventListener('scroll', function() {
  const header = document.getElementById('siteHeader');
  if (window.scrollY > 50) header.classList.add('scrolled');
  else header.classList.remove('scrolled');
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Select a navigation menu from Online Store > Navigation"
    }
  ],
  "presets": [{"name": "Header"}]
}
{% endschema %}