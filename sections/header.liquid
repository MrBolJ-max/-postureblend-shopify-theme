<style>
.site-header {
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  position: sticky;
  top: 0;
  z-index: 99;
  transition: all 0.3s ease;
}
.site-header.scrolled {
  background: rgba(0,0,0,0.95);
}
.header-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #fff;
  text-decoration: none;
}
.logo span {
  color: #888;
}
.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
  margin: 0;
  padding: 0;
}
.nav-links a {
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: color 0.2s;
}
.nav-links a:hover {
  color: #fff;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}
.cart-btn {
  position: relative;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
.cart-btn svg {
  width: 24px;
  height: 24px;
  stroke: #fff;
}
.cart-count {
  position: absolute;
  top: 0;
  right: 0;
  background: #fff;
  color: #000;
  font-size: 10px;
  font-weight: 800;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
@media (max-width: 768px) {
  .nav-links { display: none; }
  .mobile-menu-btn { display: block; }
}
</style>

<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a href="/" class="logo">Posture<span>Blend</span></a>
    <nav>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products/postureblend-wireless-posture-correction-bra">Shop</a></li>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/pages/sizing">Sizing</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <a href="/cart" class="cart-btn" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6L5 3H2"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <button class="mobile-menu-btn" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
document.getElementById('siteHeader').addEventListener('scroll', function() {
  if (window.scrollY > 50) this.classList.add('scrolled');
  else this.classList.remove('scrolled');
});
</script>

{% schema %}
{
  "name": "Header",
  "presets": [{"name": "Header"}]
}
{% endschema %}