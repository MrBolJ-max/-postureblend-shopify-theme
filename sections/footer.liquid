<style>
.site-footer {
  background: #000;
  color: rgba(255,255,255,0.5);
  padding: 80px 24px 40px;
  border-top: 1px solid #1a1a1a;
}
.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
  margin-bottom: 60px;
}
.footer-brand .logo {
  font-size: 24px;
  font-weight: 900;
  color: #fff;
  margin-bottom: 16px;
  display: block;
  letter-spacing: -0.5px;
}
.footer-brand .logo span {
  color: rgba(255,255,255,0.5);
}
.footer-brand p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(255,255,255,0.4);
  margin-bottom: 20px;
}
.footer-social {
  display: flex;
  gap: 12px;
}
.footer-social a {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.footer-social a:hover {
  background: #fff;
  border-color: #fff;
}
.footer-social a:hover svg {
  fill: #000;
}
.footer-social svg {
  width: 14px;
  height: 14px;
  fill: #fff;
}
.footer-column h4 {
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 20px;
}
.footer-column ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.footer-column li {
  margin-bottom: 12px;
}
.footer-column a {
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  font-size: 14px;
  transition: color 0.2s;
}
.footer-column a:hover {
  color: #fff;
}
.footer-bottom {
  border-top: 1px solid #1a1a1a;
  padding-top: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 12px;
  color: rgba(255,255,255,0.3);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
@media (max-width: 768px) {
  .footer-inner { grid-template-columns: 1fr 1fr; }
  .footer-bottom { flex-direction: column; text-align: center; }
}
</style>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">Posture<span>Blend</span></a>
      <p>Engineered for women who refuse to compromise. Premium posture correction, wireless freedom.</p>
      <div class="footer-social">
        <a href="https://tiktok.com/@postureblend.bra" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg></a>
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg></a>
      </div>
    </div>
    <div class="footer-column">
      <h4>{{ section.settings.menu_1_title | default: 'Shop' }}</h4>
      <ul>
        {%- assign menu1 = linklists[section.settings.menu_1] -%}
        {%- if menu1 and menu1.links.size > 0 -%}
          {%- for link in menu1.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/products/postureblend-wireless-posture-correction-bra">PostureBlend Bra</a></li>
          <li><a href="/pages/sizing">Size Guide</a></li>
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns</a></li>
        {%- endif -%}
      </ul>
    </div>
    <div class="footer-column">
      <h4>{{ section.settings.menu_2_title | default: 'Company' }}</h4>
      <ul>
        {%- assign menu2 = linklists[section.settings.menu_2] -%}
        {%- if menu2 and menu2.links.size > 0 -%}
          {%- for link in menu2.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/privacy">Privacy Policy</a></li>
        {%- endif -%}
      </ul>
    </div>
    <div class="footer-column">
      <h4>{{ section.settings.menu_3_title | default: 'Support' }}</h4>
      <ul>
        {%- assign menu3 = linklists[section.settings.menu_3] -%}
        {%- if menu3 and menu3.links.size > 0 -%}
          {%- for link in menu3.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="mailto:support@postureblend.com">Contact</a></li>
          <li><a href="/pages/faq">Help Center</a></li>
          <li><a href="#">Track Order</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>PostureBlend © {{ 'now' | date: '%Y' }}. All rights reserved.</span>
    <span>Designed for confidence.</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1",
      "info": "First column menu (Shop links)"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2",
      "info": "Second column menu (Company links)"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3",
      "info": "Third column menu (Support links)"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Menu 3 Title",
      "default": "Support"
    }
  ],
  "presets": [{"name": "Footer"}]
}
{% endschema %}
